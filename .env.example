# Copy to .env and fill in real values before running docker compose.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Database (plain Postgres - NO pgvector extension needed by this app) ---
# IMPORTANT, PORT NOTE: this app's Postgres runs on the NATIVE default port
# 5432 (a native Postgres 18 install, role/database "clinical_case_finder").
# This is DIFFERENT from the 6 earlier "AI apps" in this project (doc-search,
# faq-chatbot, job-matcher, product-recommender, ticket-triage,
# recipe-finder), whose Postgres+pgvector runs in a Podman container on port
# 5433. Double-check which port you're pointing at if you have several of
# these sibling apps checked out at once.
POSTGRES_DB=clinical_case_finder
POSTGRES_USER=clinical_case_finder
POSTGRES_PASSWORD=clinical_case_finder
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# DEV-ONLY: USE_SQLITE=True (the default in config/settings/dev.py) runs
# manage.py commands (check, makemigrations, test) against local SQLite with
# zero external dependencies. Set to False for docker-compose/production,
# which use real Postgres. Qdrant has its own, independent fallback (see
# QDRANT_URL below) - the two toggles are unrelated.
USE_SQLITE=True

# --- Vector database (Qdrant) - see backend/apps/common/qdrant_store.py ---
# Leave QDRANT_URL unset to run on qdrant-client's embedded ":memory:" mode:
# the real Qdrant engine running in-process, no server required - this is
# what the test suite and plain `manage.py runserver` use by default. Set it
# to point at a real Qdrant service (e.g. the one started by docker-compose,
# or the standalone container already running on this machine at
# localhost:6333).
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=encounters

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api

# --- AI (apps/common/ai.py) ---
# Leave OPENAI_API_KEY unset to run the whole app (embeddings) on
# deterministic, offline stub output - no network/cost, but NOT semantically
# meaningful similarity. Set it for real similarity-search quality.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-5.6-sol
